within OpenHPL.Examples;
package TrollheimControlStudies
  "Reduced equation-based Trollheim frequency-control studies"
  extends Modelica.Icons.ExamplesPackage;
  annotation (Documentation(info="<html>
<p>Component-oriented reduced-order models for comparing isochronous, droop,
and automatic generation control after a 0.1 pu load increase.</p>
<p>All signals are deviations from a 0.5 pu, 50 Hz operating point.</p>
</html>"));
end TrollheimControlStudies;
