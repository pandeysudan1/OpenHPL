within OpenHPL;
package NewTest "Power and frequency control demonstrations"
  extends Modelica.Icons.ExamplesPackage;
  annotation(Documentation(info="<html><p>Hydropower frequency-control demonstrations inspired by the governing and active-power/frequency-control concepts in P. Kundur, Power System Stability and Control. Parameters are illustrative, not a reproduced textbook case. Start with IsochronousControl.</p></html>"));
end NewTest;
